{% extends 'base.html.twig' %}

{% block title %}Възложени задачи — Division{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f6f9; }
        .accordion-button:not(.collapsed) {
            background-color: #eef4ff;
            color: #0d6efd;
        }
    </style>
{% endblock %}

{% block body %}
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container-fluid px-4">
            <span class="navbar-brand fw-bold">Възложени задачи</span>
            <div class="d-flex gap-2">
                <a href="{{ path('app_admin_dashboard') }}" class="btn btn-sm btn-outline-warning">Назад към Админ</a>
                <a href="{{ path('app_admin_report') }}" class="btn btn-sm btn-outline-light">Справка рота</a>
                <a href="{{ path('app_calendar') }}" class="btn btn-sm btn-outline-light">Календар</a>
                <a href="{{ path('app_logout') }}" class="btn btn-sm btn-danger">Изход</a>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4 pb-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h5 class="mb-0 fw-bold">Списък със задачи ({{ totalTasksCount }})</h5>
            <div class="d-flex gap-2 align-items-center">
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary" id="expandAllBtn">Разгъни всички</button>
                    <button type="button" class="btn btn-outline-secondary" id="collapseAllBtn">Свий всички</button>
                </div>
                <div class="btn-group btn-group-sm">
                    <a href="{{ path('app_admin_tasks', {filter: 'today'}) }}" class="btn {{ currentFilter == 'today' ? 'btn-dark' : 'btn-outline-dark' }}">Днес</a>
                    <a href="{{ path('app_admin_tasks', {filter: 'week'}) }}" class="btn {{ currentFilter == 'week' ? 'btn-dark' : 'btn-outline-dark' }}">Тази седмица</a>
                    <a href="{{ path('app_admin_tasks', {filter: 'all'}) }}" class="btn {{ currentFilter == 'all' ? 'btn-dark' : 'btn-outline-dark' }}">Всички</a>
                </div>
            </div>
        </div>

        {% if groupedTasks is empty %}
            <div class="card shadow-sm">
                <div class="card-body text-center text-muted py-4">
                    Няма задачи за избрания период.
                </div>
            </div>
        {% else %}
            <div class="accordion shadow-sm" id="monthsAccordion">
                {% for monthKey, monthData in groupedTasks %}
                    {% set isFirstMonth = loop.first %}
                    {% set monthCollapseId = 'month-' ~ monthKey %}

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button
                                class="accordion-button fw-bold {{ isFirstMonth ? '' : 'collapsed' }}"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#{{ monthCollapseId }}"
                            >
                                <span class="me-3">{{ monthData.label }}</span>
                                <span class="badge bg-secondary me-1">Общо: {{ monthData.total }}</span>
                                {% if monthData.active > 0 %}
                                    <span class="badge bg-warning text-dark">Активни: {{ monthData.active }}</span>
                                {% else %}
                                    <span class="badge bg-success">Всички изпълнени</span>
                                {% endif %}
                            </button>
                        </h2>

                        <div id="{{ monthCollapseId }}" class="accordion-collapse collapse {{ isFirstMonth ? 'show' : '' }}">
                            <div class="accordion-body bg-light p-3">
                                <div class="accordion" id="weeks-{{ monthKey }}">
                                    {% for weekKey, weekData in monthData.weeks %}
                                        {% set isFirstWeek = isFirstMonth and loop.first %}
                                        {% set weekCollapseId = 'week-' ~ monthKey ~ '-' ~ loop.index %}

                                        <div class="accordion-item mb-2 border rounded overflow-hidden">
                                            <h2 class="accordion-header">
                                                <button
                                                    class="accordion-button py-2 fw-semibold {{ isFirstWeek ? '' : 'collapsed' }}"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#{{ weekCollapseId }}"
                                                >
                                                    <span class="me-3">{{ weekData.label }}</span>
                                                    <span class="badge bg-primary-subtle text-primary me-1">{{ weekData.total }} зад.</span>
                                                    {% if weekData.active > 0 %}
                                                        <span class="badge bg-warning text-dark">{{ weekData.active }} акт.</span>
                                                    {% endif %}
                                                </button>
                                            </h2>

                                            <div id="{{ weekCollapseId }}" class="accordion-collapse collapse {{ isFirstWeek ? 'show' : '' }}">
                                                <div class="table-responsive bg-white">
                                                    <table class="table table-hover align-middle mb-0">
                                                        <thead class="table-light">
                                                        <tr>
                                                            <th>Задача</th>
                                                            <th>Изпълнител</th>
                                                            <th>Възложена</th>
                                                            <th>За кога</th>
                                                            <th>Статус</th>
                                                            {% if task.seenAt %}
                                                                <div class="small text-success mt-1">👁 Видяна ({{ task.seenAt|date('d.m H:i') }})</div>
                                                            {% elseif not task.isCompleted %}
                                                                <div class="small text-muted mt-1">Непрочетена</div>
                                                            {% endif %}
                                                        </tr>
                                                        </thead>
                                                        <tbody>
                                                        {% for t in weekData.tasks %}
                                                            <tr>
                                                                <td>
                                                                    <div class="fw-semibold">{{ t.title }}</div>
                                                                    {% if t.description %}<small class="text-muted">{{ t.description }}</small>{% endif %}
                                                                </td>
                                                                <td>{{ t.assignedTo.militaryRank }} {{ t.assignedTo.fullName }}</td>
                                                                <td>{{ t.createdAt|date('d.m H:i') }}</td>
                                                                <td>{{ t.dueDate ? t.dueDate|date('d.m.Y H:i') : '—' }}</td>
                                                                <td>
                                                                    {% if t.isCompleted %}
                                                                        <span class="badge bg-success">Изпълнена ({{ t.completedAt|date('d.m H:i') }})</span>
                                                                        {% if t.completionNote %}
                                                                            <div class="small text-muted mt-1"><strong>Бележка:</strong> {{ t.completionNote }}</div>
                                                                        {% endif %}
                                                                    {% else %}
                                                                        <span class="badge bg-warning text-dark">Активна</span>
                                                                    {% endif %}
                                                                </td>
                                                            </tr>
                                                        {% endfor %}
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const collapses = () => document.querySelectorAll('#monthsAccordion .accordion-collapse');

            document.getElementById('expandAllBtn')?.addEventListener('click', () => {
                collapses().forEach(el => bootstrap.Collapse.getOrCreateInstance(el, { toggle: false }).show());
            });

            document.getElementById('collapseAllBtn')?.addEventListener('click', () => {
                collapses().forEach(el => bootstrap.Collapse.getOrCreateInstance(el, { toggle: false }).hide());
            });
        });
    </script>
{% endblock %}
