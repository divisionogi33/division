{% extends 'base.html.twig' %}

{% block title %}Потребители и роли — Division{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container-fluid px-4">
            <span class="navbar-brand fw-bold">Потребители и роли</span>
            <div class="d-flex gap-2">
                <a href="{{ path('app_admin_dashboard') }}" class="btn btn-sm btn-outline-warning">Назад към Админ</a>
                <a href="{{ path('app_calendar') }}" class="btn btn-sm btn-outline-light">Календар</a>
                <a href="{{ path('app_logout') }}" class="btn btn-sm btn-danger">Изход</a>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4 pb-5">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Списък на личния състав</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>Служител</th>
                        <th>Роля</th>
                        <th>Статус</th>
                        <th class="text-end">Действия</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for u in users %}
                        <tr>
                            <td>
                                <div class="fw-semibold">{{ u.militaryRank }} {{ u.fullName }}</div>
                                <small class="text-muted">{{ u.position }} • {{ u.email }}</small>
                            </td>
                            <td>
                                {% if 'ROLE_ADMIN' in u.roles %}
                                    <span class="badge bg-danger">ADMIN</span>
                                {% else %}
                                    <span class="badge bg-secondary">USER</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if u.isApproved %}
                                    <span class="badge bg-success">Одобрен</span>
                                {% else %}
                                    <span class="badge bg-warning text-dark">Чака</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <form method="post" action="{{ path('app_admin_user_toggle_approve', {id: u.id}) }}" class="d-inline">
                                    <button class="btn btn-sm btn-outline-success">
                                        {{ u.isApproved ? 'Блокирай' : 'Одобри' }}
                                    </button>
                                </form>
                                {% if u != app.user %}
                                    <form method="post"
                                          action="{{ path('app_admin_user_delete', {id: u.id}) }}"
                                          class="d-inline"
                                          onsubmit="return confirm('Сигурен ли си, че искаш да изтриеш {{ u.fullName }}? Това ще изтрие и всички негови смени, задачи и отпуски!');">
                                        <button type="submit" class="btn btn-sm btn-danger">Изтрий</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
