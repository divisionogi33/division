{% extends 'base.html.twig' %}

{% block title %}Месечен график (Табел) — Division{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .schedule-table th, .schedule-table td {
            padding: 4px 3px !important;
            text-align: center;
            vertical-align: middle;
            font-size: 0.78rem;
            min-width: 34px;
        }
        .schedule-table .sticky-col {
            position: sticky;
            left: 0;
            background: #fff;
            z-index: 2;
            text-align: left !important;
            min-width: 215px;
            padding: 6px 10px !important;
            border-right: 2px solid #dee2e6;
        }
        .schedule-table thead .sticky-col {
            background: #f8f9fa;
            z-index: 3;
        }
        .schedule-table tfoot .sticky-col {
            background: #212529;
            color: #fff;
        }
        .weekend-col {
            background-color: #f1f3f5 !important;
        }
        .shift-pill {
            display: block;
            border-radius: 3px;
            color: #fff;
            font-weight: 600;
            font-size: 0.7rem;
            padding: 1px 2px;
            margin-bottom: 1px;
            cursor: default;
        }
    </style>
{% endblock %}

{% block body %}
    <nav class="navbar navbar-dark bg-dark mb-3">
        <div class="container-fluid px-4">
            <span class="navbar-brand fw-bold">Месечен график на ротата</span>
            <div class="d-flex gap-2">
                <a href="{{ path('app_admin_dashboard') }}" class="btn btn-sm btn-outline-warning">Назад към Админ</a>
                <a href="{{ path('app_calendar') }}" class="btn btn-sm btn-outline-light">Календар</a>
                <a href="{{ path('app_logout') }}" class="btn btn-sm btn-danger">Изход</a>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-3 pb-5">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
                {{ message }}
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
                {{ message }}
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {# Избор на месец + Норма + Експорт/Импорт + Легенда #}
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <form method="get" action="{{ path('app_admin_report') }}" class="d-flex gap-2 align-items-center">
                <label class="fw-semibold mb-0">Месец:</label>
                <input type="month" name="month" class="form-control form-control-sm" style="width: 170px;" value="{{ selectedMonth }}">
                <button type="submit" class="btn btn-sm btn-dark">Покажи</button>
                <span class="badge bg-info text-dark fs-6 ms-2">
                    Норма: {{ workingDays }} раб. дни ({{ normHours }} ч.)
                </span>
            </form>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <a href="{{ path('app_admin_report_export', {year: year, month: month}) }}" class="btn btn-success btn-sm">
                    Експорт в Excel (.xlsx)
                </a>
                <form method="post" action="{{ path('app_admin_report_import') }}" enctype="multipart/form-data" class="d-inline-flex align-items-center gap-2">
                    <input type="hidden" name="month" value="{{ selectedMonth }}">
                    <input type="file" name="excelFile" accept=".xlsx" class="form-control form-control-sm" style="width: 210px;" required>
                    <div class="form-check form-check-inline m-0">
                        <input class="form-check-input" type="checkbox" name="replaceExisting" value="1" id="replaceExisting" checked>
                        <label class="form-check-label small" for="replaceExisting">Замени месеца</label>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Upload Excel</button>
                </form>
            </div>

            <div class="d-flex flex-wrap gap-1">
                {% for l in legends %}
                    <span class="badge" style="background-color: {{ l.colorHex }};">
                        {{ l.code }} — {{ l.name }} ({{ l.defaultDailyHours }} ч.)
                    </span>
                {% endfor %}
            </div>
        </div>

        {# Таблица тип месечен график 1..30/31 #}
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-bordered table-hover schedule-table mb-0">
                    <thead class="table-light">
                    <tr>
                        <th class="sticky-col">Звание, Име и Фамилия</th>
                        {% for d in days %}
                            <th
                                class="{{ d.holidayName ? 'bg-danger text-white' : (d.isWeekend ? 'weekend-col text-danger' : '') }}"
                                {% if d.holidayName %}title="Празник: {{ d.holidayName }}"{% endif %}
                            >
                                {{ d.num }}
                            </th>
                        {% endfor %}
                        <th class="bg-primary text-white" style="min-width: 65px;">Часове</th>
                        <th class="bg-dark text-white" style="min-width: 85px;">До норма</th>
                        <th class="bg-success text-white" style="min-width: 65px;">Задачи</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in rows %}
                        {% set dayMap = {} %}
                        {% for d in days %}
                            {% set codes = [] %}
                            {% for cs in row.days[d.num] %}
                                {% if cs.code not in codes %}
                                    {% set codes = codes|merge([cs.code]) %}
                                {% endif %}
                            {% endfor %}
                            {% set dayMap = dayMap|merge({ (d.num): codes|join('/') }) %}
                        {% endfor %}

                        <tr>
                            <td class="sticky-col">
                                <div class="d-flex justify-content-between align-items-center gap-1">
                                    <div>
                                        <div class="fw-bold">{{ row.user.militaryRank }} {{ row.user.fullName }}</div>
                                        <small class="text-muted">{{ row.user.position }}</small>
                                    </div>
                                    <button
                                        type="button"
                                        class="btn btn-sm btn-outline-secondary py-0 px-1 edit-row-btn"
                                        title="Редактирай графика"
                                        data-url="{{ path('app_admin_report_user_update', {id: row.user.id}) }}"
                                        data-name="{{ row.user.militaryRank }} {{ row.user.fullName }}"
                                        data-days='{{ dayMap|json_encode|raw }}'
                                    >
                                        ✎
                                    </button>
                                </div>
                            </td>

                            {% for d in days %}
                                {% set cellShifts = row.days[d.num] %}
                                <td class="{{ d.isWeekend ? 'weekend-col' : '' }}">
                                    {% for cs in cellShifts %}
                                        <span
                                            class="shift-pill"
                                            style="background-color: {{ cs.color }};"
                                            title="{{ cs.name }} | Място: {{ cs.location }} | {{ cs.hours }} ч."
                                        >
                                            {{ cs.code }}
                                        </span>
                                    {% endfor %}
                                </td>
                            {% endfor %}

                            <td class="fw-bold text-primary">{{ row.hours }} ч.</td>

                            {% set diff = row.personalNorm - row.hours %}
                            <td class="fw-bold">
                                {% if diff > 0 %}
                                    <span class="text-danger">-{{ diff }} ч.</span>
                                {% elseif diff < 0 %}
                                    <span class="text-success">+{{ diff|abs }} ч.</span>
                                {% else %}
                                    <span class="badge bg-success">Норма</span>
                                {% endif %}
                            </td>

                            <td>
                                {% if row.tasksTotal == 0 %}
                                    <span class="text-muted">0/0</span>
                                {% else %}
                                    <span class="badge {{ row.tasksCompleted == row.tasksTotal ? 'bg-success' : 'bg-warning text-dark' }}">
                                        {{ row.tasksCompleted }}/{{ row.tasksTotal }}
                                    </span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="{{ days|length + 4 }}" class="text-center text-muted py-4">
                                Няма регистрирани служители.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                    <tfoot>
                    <tr class="table-dark fw-bold">
                        <td class="sticky-col">ОБЩО ЗА РОТАТА</td>
                        <td colspan="{{ days|length }}" class="text-end pe-3">Общо за {{ selectedMonth }}:</td>
                        <td class="text-warning">{{ companyTotalHours }} ч.</td>
                        <td class="text-light">{{ normHours }} ч./чов.</td>
                        <td class="text-info">{{ companyCompletedTasks }}/{{ companyTotalTasks }}</td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    {# Модал за ръчна редакция на графика на един служител #}
    <div class="modal fade" id="editUserScheduleModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <form method="post" id="editUserScheduleForm" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Редакция на график: <span id="editUserName" class="text-primary"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="month" value="{{ selectedMonth }}">
                    <div class="small text-muted mb-2">
                        Кодове:
                        {% for l in legends %}
                            <span class="badge me-1" style="background-color: {{ l.colorHex }}">{{ l.code }}</span>
                        {% endfor %}
                        (за комбинирани пиши с наклонена черта, напр. <code>КОМ/Д</code>; остави празно за почивен)
                    </div>
                    <div class="row g-2">
                        {% for d in days %}
                            <div class="col-4 col-sm-3 col-md-2">
                                <label class="form-label small mb-0 fw-semibold {{ d.isWeekend or d.holidayName ? 'text-danger' : '' }}">
                                    {{ d.num }} {{ d.isWeekend ? '(поч.)' : '' }}
                                </label>
                                <input
                                    type="text"
                                    name="days[{{ d.num }}]"
                                    id="edit-day-{{ d.num }}"
                                    class="form-control form-control-sm text-uppercase"
                                    placeholder="-"
                                >
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Отказ</button>
                    <button type="submit" class="btn btn-primary btn-sm">Запази промените</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalEl = document.getElementById('editUserScheduleModal');
            const modal = new bootstrap.Modal(modalEl);
            const form = document.getElementById('editUserScheduleForm');
            const nameEl = document.getElementById('editUserName');

            document.querySelectorAll('.edit-row-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    form.action = this.dataset.url;
                    nameEl.textContent = this.dataset.name;
                    const dayMap = JSON.parse(this.dataset.days || '{}');

                    form.querySelectorAll('input[id^="edit-day-"]').forEach(input => {
                        const dayNum = input.id.replace('edit-day-', '');
                        input.value = dayMap[dayNum] || '';
                    });

                    modal.show();
                });
            });
        });
    </script>
{% endblock %}
