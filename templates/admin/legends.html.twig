{% extends 'base.html.twig' %}

{% block title %}Типове смени (Легенда) — Division{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container-fluid px-4">
            <span class="navbar-brand fw-bold">Типове смени и дежурства</span>
            <div class="d-flex gap-2">
                <a href="{{ path('app_admin_dashboard') }}" class="btn btn-sm btn-outline-warning">Назад към Админ</a>
                <a href="{{ path('app_calendar') }}" class="btn btn-sm btn-outline-light">Календар</a>
                <a href="{{ path('app_logout') }}" class="btn btn-sm btn-danger">Изход</a>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4 pb-5">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="row g-4">
            {# Форма за нов тип смяна/дежурство #}
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header fw-bold">Добави ново дежурство / смяна</div>
                    <div class="card-body">
                        <form method="post" action="{{ path('app_admin_legend_create') }}">
                            <div class="mb-2">
                                <label class="form-label">Код (съкращение)</label>
                                <input type="text" name="code" class="form-control" maxlength="10" placeholder="напр. Д12, Д24, НС" required>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Име</label>
                                <input type="text" name="name" class="form-control" placeholder="напр. Дежурство 12 часа" required>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label">Часове на ден</label>
                                    <input type="number" step="0.5" min="0" max="24" name="defaultDailyHours" class="form-control" value="12" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Коефициент</label>
                                    <input type="number" step="0.1" min="0.1" name="multiplier" class="form-control" value="1.0">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Цвят в календара</label>
                                <input type="color" name="colorHex" class="form-control form-control-color w-100" value="#fd7e14">
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Запази</button>
                        </form>
                    </div>
                </div>
            </div>

            {# Списък на съществуващите типове #}
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header fw-bold">Налични типове в легендата</div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                            <tr>
                                <th>Код</th>
                                <th>Име</th>
                                <th>Часове/ден</th>
                                <th>Коефициент</th>
                                <th class="text-end">Действие</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for l in legends %}
                                <tr>
                                    <td>
                                        <span class="badge fs-6" style="background-color: {{ l.colorHex }}">{{ l.code }}</span>
                                    </td>
                                    <td class="fw-semibold">{{ l.name }}</td>
                                    <td>{{ l.defaultDailyHours }} ч.</td>
                                    <td>× {{ l.multiplier }}</td>
                                    <td class="text-end">
                                        <form method="post" action="{{ path('app_admin_legend_delete', {id: l.id}) }}" class="d-inline">
                                            <button class="btn btn-sm btn-outline-danger">Изтрий</button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="5" class="text-center text-muted py-3">Няма добавени типове.</td></tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
