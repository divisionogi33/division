{% extends 'base.html.twig' %}

{% block title %}Моят профил{% endblock %}

{% block body %}
    <div class="container mt-4" style="max-width: 520px;">
        <h2 class="mb-3">Моят профил</h2>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <form method="post" action="{{ path('app_profile') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('profile_update') }}">

            <div class="mb-3">
                <label class="form-label">Имейл</label>
                <input type="email" class="form-control" value="{{ user.email }}" disabled>
            </div>

            <div class="mb-3">
                <label for="first_name" class="form-label">Име</label>
                <input type="text" id="first_name" name="first_name" class="form-control"
                       value="{{ user.firstName }}" required>
            </div>

            <div class="mb-3">
                <label for="last_name" class="form-label">Фамилия</label>
                <input type="text" id="last_name" name="last_name" class="form-control"
                       value="{{ user.lastName }}" required>
            </div>

            <hr class="my-4">
            <h5 class="mb-3">Смяна на парола <small class="text-muted">(по желание)</small></h5>

            <div class="mb-3">
                <label for="new_password" class="form-label">Нова парола</label>
                <input type="password" id="new_password" name="new_password" class="form-control"
                       minlength="6" autocomplete="new-password">
            </div>

            <div class="mb-3">
                <label for="confirm_password" class="form-label">Потвърди новата парола</label>
                <input type="password" id="confirm_password" name="confirm_password" class="form-control"
                       minlength="6" autocomplete="new-password">
            </div>

            <button type="submit" class="btn btn-primary w-100">Запази промените</button>
        </form>
    </div>
{% endblock %}
